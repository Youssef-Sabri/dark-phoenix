# ============================================================
# DARK PHOENIX - Environment Variables Configuration
# ============================================================

# ============================================================
# 1. VERCEL ONLY (Frontend)
# ============================================================

# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?pgbouncer=true"

# NextAuth & App
AUTH_SECRET="your_nextauth_secret_min_32_chars"
BASE_URL="https://your-domain.vercel.app"
SKIP_ENV_VALIDATION="true"

# Backend connection — the Space is PRIVATE: requests require an HF token with
# read access to Y0sf/dark-phoenix-backend (must equal AUTH_TOKEN on the Space).
PROCESS_VIDEO_ENDPOINT="https://y0sf-dark-phoenix-backend.hf.space/process_video"
PROCESS_VIDEO_ENDPOINT_AUTH="hf_your_huggingface_read_token"

# Inngest Background Queue (v3 cloud mode - REQUIRED in production)
# Without these, inngest.send() throws in cloud mode (Vercel) and the
# /api/inngest handler returns 401 to Inngest Cloud. Local dev auto-falls back
# to the Dev Server on localhost:8288, so they are optional locally.
INNGEST_EVENT_KEY="your_inngest_event_key"
INNGEST_SIGNING_KEY="your_inngest_signing_key"

# Stripe Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SMALL_CREDIT_PACK="price_small_..."
STRIPE_MEDIUM_CREDIT_PACK="price_medium_..."
STRIPE_LARGE_CREDIT_PACK="price_large_..."


# ============================================================
# 2. HUGGING FACE ONLY (Backend Secrets)
# ============================================================

# Backend API auth — set to the SAME HF read token as PROCESS_VIDEO_ENDPOINT_AUTH
# so the Authorization header passes both the private-Space edge and the app check.
AUTH_TOKEN="hf_your_huggingface_read_token"

# Gemini AI (highlight detection)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Optional: Force the Whisper transcription model on CPU (default "base.en")
# WHISPER_CPU_MODEL="base.en"

# Optional: Override the TalkNet active-speaker-detection asset directory (unset = bundled default)
# ASD_DIR="/path/to/asd"

# Optional: Local test runner only — S3 key of a source video to process via main.py (no webhook)
# TEST_S3_KEY="uploads/your_video/original.mp4"


# ============================================================
# 3. BOTH VERCEL & HUGGING FACE (Storage)
# ============================================================

# Supabase S3 Gateway
AWS_ACCESS_KEY_ID="your_supabase_s3_access_key_id"
AWS_SECRET_ACCESS_KEY="your_supabase_s3_secret_access_key"
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL_S3="https://YOUR_PROJECT_ID.supabase.co/storage/v1/s3"
S3_BUCKET_NAME="dark-phoenix"


# ============================================================
# 4. GITHUB ACTIONS ONLY (Keep-Alive Workflow)
# ============================================================

# Same HF read token, added as a repository secret `HF_TOKEN`; the keep-alive
# workflow uses it to ping GET /health on the private Space.
HF_TOKEN="hf_your_huggingface_read_token"
